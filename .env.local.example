# Supabase (get from https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# 服务密钥（secret key，仅服务端脚本 serviceClient 使用；本地可暂缺，调用时报错）
SUPABASE_SECRET_KEY=your_supabase_service_key

# Meilisearch (get from https://www.meilisearch.com/cloud)
NEXT_PUBLIC_MEILISEARCH_URL=your_meilisearch_url
MEILISEARCH_API_KEY=your_meilisearch_api_key

# Analytics (Plausible — optional, privacy-friendly)
NEXT_PUBLIC_ANALYTICS_DOMAIN=chinaprohub.com
NEXT_PUBLIC_ANALYTICS_API=https://plausible.io/api/event
